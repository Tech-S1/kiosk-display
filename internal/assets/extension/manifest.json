{
  "manifest_version": 3,
  "name": "Kiosk HUD",
  "version": "0.0.0",
  "description": "HUD for kiosk-display",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [],
  "host_permissions": [],
  "web_accessible_resources": [
    {
      "resources": ["content.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
